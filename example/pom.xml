<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.gv2011</groupId>
    <artifactId>dependency-analyser</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>dependency-analyser-example</artifactId>
  <packaging>jar</packaging>

  <name>Dependency Analyser Example</name>
  <description>
    A small, real Maven project with one known dependency (slf4j-api).
    Not part of the tool itself - exists to be built, mvn-installed with a
    sources attachment, and extracted from that attachment in an
    integration test, so the test runs against a genuine project on disk
    rather than one hand-assembled inline.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
            <configuration>
              <!-- Without this, the sources jar contains only .java files,
                   not the pom.xml - not enough for dependency:list to
                   recognise the extracted copy as a project at all
                   (confirmed directly: MissingProjectException, "no POM in
                   this directory"). -->
              <includePom>true</includePom>
              <!-- Default forceCreation=false skips regenerating the jar
                   when sources aren't newer than the existing one - which
                   doesn't account for a plugin *configuration* change
                   (e.g. includePom above) with no source file touched.
                   This module's only purpose is being a reliable, current
                   test fixture, so always regenerate. -->
              <forceCreation>true</forceCreation>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>

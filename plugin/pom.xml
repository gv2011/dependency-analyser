<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.gv2011</groupId>
    <artifactId>dependency-analyser</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>major-updates-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>Major Updates Maven Plugin</name>
  <description>
    Quick-and-dirty aggregator Mojo that reports major-version updates (dependencies,
    dependencyManagement entries, and plugins) across an entire multi-module reactor, as either
    CSV or JSON (see the outputFormat parameter), filtering out pre-release qualifiers via the
    standard versions-maven-plugin ruleSet mechanism. Same artifactId and goal as before the
    module split, so existing usage is unaffected. Depends on major-updates-shared at ordinary
    (compile) scope for the JSON output option's transport type; everything else (Dependency,
    Version, CsvFormatter, JsonFormatter, MajorUpdatesReportGenerator, MajorUpdatesMojo) still
    lives entirely in this module.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.github.gv2011</groupId>
      <artifactId>dependency-analyser-shared</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The existing plugin's own extension API: this is what we're building on top of,
         per the "invoke the existing plugin programmatically" approach, rather than shelling
         out to mvn or scraping console/report output. -->
    <dependency>
      <groupId>org.codehaus.mojo.versions</groupId>
      <artifactId>versions-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- @Inject, used for VersionsHelper injection (see MajorUpdatesMojo). This is likely already
         transitively available via maven-core's Sisu-based DI container, but that transitive path
         hasn't specifically been confirmed, so it's declared explicitly rather than relied on. -->
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- @Nullable, used at the one point where an external API (ArtifactVersions) can hand us
         a null we don't control; see the comments in MajorUpdatesReportGenerator. -->
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
    </dependency>

    <!-- ImmutableList, for MajorUpdatesReportGenerator.generate's defensive copy of the reactor
         project list: a real, independent copy rather than a reference that could still be
         mutated by whatever else holds the original list. Deliberately NOT provided scope;
         Maven's own runtime does not supply Guava, unlike maven-core/javax.inject above. -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Generates plugin.xml so this jar is actually usable as a Maven plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-plugin.version}</version>
        <configuration>
          <!-- maven-plugin-plugin 3.13.1 made the goal prefix mandatory (MPLUGIN-450) and its
               automatic computation from the artifactId isn't reliably succeeding here (at least
               under m2e); set it explicitly rather than relying on that computation.
               "major-updates" matches this plugin's own goal name, so usage stays
               mvn major-updates:major-updates if ever invoked via the short form. -->
          <goalPrefix>major-updates</goalPrefix>
        </configuration>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <phase>process-classes</phase>
            <goals>
              <goal>descriptor</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

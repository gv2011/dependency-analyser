<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.gv2011</groupId>
  <artifactId>dependency-analyser</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <description>
    Experimental
  </description>

  <modules>
    <module>shared</module>
    <module>api</module>
    <module>implementation</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Not used by any module yet; pinned now because the planned
         implementation module will embed Maven via MavenCli at exactly this
         version (see the maven-core/maven-embedder/maven-compat entries
         below). -->
    <maven.version>3.9.9</maven.version>

    <!-- Maven 3.9.9's own release notes state it ships Resolver 1.9.22;
         maven-resolver-connector-basic/transport-http aren't pulled in
         transitively by maven-core/maven-embedder (a real Maven install
         bundles them separately), so they're added explicitly below at
         this exact version to avoid an API mismatch. -->
    <maven-resolver.version>1.9.22</maven-resolver.version>

    <junit-jupiter.version>6.1.3</junit-jupiter.version>
    <hamcrest.version>3.0</hamcrest.version>

    <!-- com.github.gv2011:util-apis, used by dependency-analyser-api for
         IList/ISet: https://github.com/gv2011/util-apis -->
    <util-apis.version>0.17.1</util-apis.version>
    <util.version>0.25.2</util.version>

    <!-- Confirmed via maven-slf4j-provider:3.9.9's own published dependency
         list (the exact Maven version pinned above): this is the slf4j-api
         version already in play transitively through maven-core/
         maven-embedder's own dependency graph, so pinning it here explicitly
         (for the future implementation module's own direct logging use)
         can't introduce a convergence conflict with what's already
         resolved. -->
    <slf4j-api.version>2.0.19</slf4j-api.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-core</artifactId>
        <version>${maven.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-embedder</artifactId>
        <version>${maven.version}</version>
      </dependency>
      <!-- maven-core's DefaultProjectBuildingHelper still depends on the legacy
           org.apache.maven.repository.RepositorySystem interface; maven-compat is what
      actually
           implements it. A real Maven install bundles this in its own lib/ folder by
      default
           (confirmed: MNG-5995, "Maven itself cannot run without maven-compat");
      depending on
           maven-embedder purely as a library does not pull it in automatically. Without
      this,
           MavenCli.container(...) fails with a Guice ProvisionException, "No
      implementation for
           RepositorySystem was bound"; confirmed directly against a real stack trace. -->
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-compat</artifactId>
        <version>${maven.version}</version>
      </dependency>
      <!-- Without these, an embedded build fails with
           "NoRepositoryConnectorException: No connector factories
           available" the first time it needs to actually download
           anything (e.g. a plugin) from a remote repository -- confirmed
           directly against a real stack trace. maven-core/maven-embedder
           give you the resolver API, not a way to talk to a repository
           over HTTP; a real Maven install bundles that separately. -->
      <dependency>
        <groupId>org.apache.maven.resolver</groupId>
        <artifactId>maven-resolver-connector-basic</artifactId>
        <version>${maven-resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.resolver</groupId>
        <artifactId>maven-resolver-transport-http</artifactId>
        <version>${maven-resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.resolver</groupId>
        <artifactId>maven-resolver-transport-file</artifactId>
        <version>${maven-resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j-api.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.gv2011</groupId>
        <artifactId>util-apis</artifactId>
        <version>${util-apis.version}</version>
      </dependency>
      
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.6.3</version>
        <scope>runtime</scope>
      </dependency>
      
      <dependency>
        <groupId>com.github.gv2011</groupId>
        <artifactId>util-gcol</artifactId>
        <version>${util.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.github.gv2011</groupId>
        <artifactId>util-beans</artifactId>
        <version>${util.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.github.gv2011</groupId>
        <artifactId>util-json</artifactId>
        <version>${util.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.github.gv2011</groupId>
        <artifactId>gsoncore</artifactId>
        <version>0.15.1</version>
        <scope>runtime</scope>
      </dependency>
      
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.hamcrest</groupId>
        <artifactId>hamcrest</artifactId>
        <version>${hamcrest.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
